{
  "name": "llm-automation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "app": "node --env-file-if-exists=.env --import tsx src/demo-app.ts",
    "discover": "node --env-file-if-exists=.env --import tsx src/cli.ts discover",
    "replay": "node --env-file-if-exists=.env --import tsx src/cli.ts replay",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:offline": "node --env-file-if-exists=.env --import tsx scripts/offline-demo.ts",
    "demo:assurance": "node --env-file-if-exists=.env --import tsx scripts/assurance-lab.ts",
    "check:submission": "node --import tsx scripts/check-submission.ts"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
