# Configure a real provider before running discovery. Never commit credentials.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible endpoint (HTTPS only).
# LLM_BASE_URL=https://api.openai.com/v1
# Use installed Chrome, or run: npx playwright install chromium
BROWSER_CHANNEL=chrome
# Discovery invokes the Python API connectors; replay does not need Python.
# PYTHON_BIN=python3
